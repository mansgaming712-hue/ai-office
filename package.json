{
  "name": "ai-office",
  "version": "1.0.0",
  "private": true,
  "description": "AI Office: tim subagent Claude Code + animasi kantor pixel art yang menampilkan delegasi secara langsung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mansgaming712-hue/ai-office.git"
  },
  "homepage": "https://github.com/mansgaming712-hue/ai-office#readme",
  "bugs": {
    "url": "https://github.com/mansgaming712-hue/ai-office/issues"
  },
  "author": "mans (https://github.com/mansgaming712-hue)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "serve": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "agents:install": "node scripts/install-agents.mjs",
    "agents:validate": "node scripts/validate-agents.mjs",
    "demo:hooks": "node scripts/demo-hooks.mjs",
    "hooks:install-user": "node scripts/install-user-hooks.mjs",
    "hooks:uninstall-user": "node scripts/uninstall-user-hooks.mjs",
    "usage": "node scripts/usage-report.mjs",
    "usage:sample": "node scripts/make-usage-sample.mjs",
    "token": "node scripts/gen-token.mjs",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-autostart.ps1",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/uninstall-autostart.ps1",
    "autostart:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/stop-ai-office.ps1"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT"
}
