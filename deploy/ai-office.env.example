# CONTOH file env AI Office. JANGAN mengisi token asli di file ini atau di repo mana pun.
#
# File asli: /etc/ai-office/ai-office.env (izin 600, milik root), dibuat otomatis oleh
# deploy/setup-vps.sh dan dibaca systemd lewat EnvironmentFile= di ai-office.service.
# Format systemd: satu KEY=nilai per baris, tanpa spasi di sekitar "=".
#
# HOST=127.0.0.1 dan PORT=3000 sudah diatur di deploy/systemd/ai-office.service.
# JANGAN menaruh HOST atau PORT di file ini (nilainya akan menimpa service dan Nginx tidak
# bisa lagi menemukan app).

# Token rahasia, minimal 32 karakter. Dipakai untuk login browser dan oleh hooks
# (header Authorization: Bearer). Sengaja dikosongkan di contoh ini: server MENOLAK start bila
# token kosong atau kurang dari 32 karakter. Buat token baru dengan salah satu:
#   openssl rand -base64 32
#   node scripts/gen-token.mjs
# Ganti token di server yang sudah jalan: sudo bash /opt/ai-office/current/deploy/rotate-token.sh
AI_OFFICE_TOKEN=

# Hostname publik yang boleh muncul di header Host/Origin. Tanpa https://, tanpa port,
# pisahkan dengan koma bila lebih dari satu.
AI_OFFICE_ALLOWED_HOSTS=office.example.com

# 1 = app berada di belakang Nginx: percaya X-Real-IP (IP klien) dan X-Forwarded-Proto (HTTPS).
# Server menolak start bila nilai ini 1 tetapi HOST bukan 127.0.0.1 (app tidak boleh terbuka).
AI_OFFICE_TRUST_PROXY=1

# OPSIONAL, default mati. Secara default log app (journald, tersimpan di disk) hanya berisi
# metadata event: tipe, pengirim, penerima, panjang pesan. Isi 1 untuk ikut mencatat ISI pesan
# (judul tugas, nama file). Aktifkan hanya sementara untuk debugging, lalu hapus dan restart.
# AI_OFFICE_LOG_MESSAGES=1
