node_modules/
dist/
*.log
logs/
data/

# Rahasia dan konfigurasi lokal: jangan pernah di-commit.
.env
.env.*
!.env.example
# .claude/: hanya dua file konfigurasi bersama yang boleh ikut; sisanya (settings.local.json,
# worktree, cache, catatan lokal) selalu diabaikan.
.claude/*
!.claude/settings.json
!.claude/launch.json
*.bak-*
*.pem
*.key

# Konfigurasi pribadi (contohnya ada di limit-config.example.json).
limit-config.json

# Laporan internal manajer ke CEO (berisi path dan detail mesin lokal).
reports/*
!reports/.gitkeep
