# AI Office — contoh konfigurasi.
# Salin menjadi .env (file .env tidak ikut ke git), lalu isi yang perlu saja.
# Semua boleh kosong: tanpa isi, server jalan di mode lokal (127.0.0.1:3000, tanpa login).
# Variabel yang sudah ada di environment (shell, systemd, settings.json Claude Code) tidak ditimpa .env.

# --- Server ---------------------------------------------------------------
PORT=
HOST=
# Token akses (rahasia). Buat dengan: npm run -s token
# Wajib minimal 32 karakter bila server dibuka ke jaringan (HOST publik / ALLOWED_HOSTS / TRUST_PROXY).
AI_OFFICE_TOKEN=
# Alternatif yang lebih aman: path file berisi token ("~" = home), dipakai bila AI_OFFICE_TOKEN kosong.
AI_OFFICE_TOKEN_FILE=
# Hostname dipisah koma yang boleh muncul di header Host/Origin (mode terbuka).
AI_OFFICE_ALLOWED_HOSTS=
# Isi 1 bila server di belakang Nginx di mesin yang sama.
AI_OFFICE_TRUST_PROXY=
# Origin dev server (mis. http://localhost:5173) yang diizinkan di mode lokal.
AI_OFFICE_DEV_ORIGINS=
# Isi 1 untuk ikut mencatat isi pesan event di log (default: hanya metadata).
AI_OFFICE_LOG_MESSAGES=
# Folder dasar log Claude Code untuk panel Pemakaian Limit (default: ~/.claude).
AI_OFFICE_CLAUDE_DIR=
# Path limit-config.json (default: root proyek). Contoh isi: limit-config.example.json.
AI_OFFICE_LIMIT_CONFIG=

# --- Hook Claude Code (hooks/send-event.mjs) -------------------------------
# Alamat server tujuan event (default http://127.0.0.1:3000/api/events). Wajib https:// bila bukan localhost.
AI_OFFICE_URL=
# Batas waktu kirim event dalam ms (default 800).
AI_OFFICE_TIMEOUT_MS=
# Isi 1 untuk menampilkan error hook di stderr (token tidak pernah dicetak).
AI_OFFICE_DEBUG=
